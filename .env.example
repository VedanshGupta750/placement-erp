# Required — the app will not start without these.
DATABASE_URL="postgresql://user:password@localhost:5432/placement_erp_dev?schema=public"
JWT_SECRET="a long random string, e.g. `openssl rand -base64 32`"
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Allow phone browsers to load Next.js development assets. Replace this with
# the computer's current Wi-Fi IPv4 address when it changes.
DEV_ALLOWED_ORIGIN="10.104.90.102"

# Developer-owned PWA identity. These values are set by the code owner or
# deployment owner and are not editable from a college account.
NEXT_PUBLIC_PWA_NAME="Placement ERP"
NEXT_PUBLIC_PWA_SHORT_NAME="Placement ERP"
NEXT_PUBLIC_PWA_DESCRIPTION="Campus placement management for students, placement teams, and recruiters."
NEXT_PUBLIC_DEVELOPER_NAME="Your development company"
NEXT_PUBLIC_PWA_LOGO_PATH="/pwa/icon-512.png"
# Put the image inside `public/pwa`. A path such as
# `public/pwa/college-logo.png` is also accepted and converted automatically.

# Optional — powers the AI layer (resume/JD parsing, TPO copilot)
# (Anthropic is preferred if both are set); leave both unset for stub mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — secures the /api/cron/* routes (time-based automation like the
# registration-closing-soon reminder). Without it, those routes respond
# 501 rather than running unauthenticated. If deployed on Vercel, set this
# in the project's env vars and Vercel Cron (see vercel.json) will send it
# as the Authorization: Bearer header automatically; on another host, point
# that host's own scheduler at the same route with the same header.
CRON_SECRET=

# Optional — enables per-user Web Push. Generate a key pair with
# `npx web-push generate-vapid-keys`. Keep the private key server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:notifications@example.com"
VAPID_KEY_ID="default"

# Optional — enables the "Assessments" nav link, which SSO-hands off to the
# standalone assessment microservice at ~/placement-erp-assessments. Its
# JWT_SECRET must be set to this exact same value — that shared secret is
# the entire SSO trust contract between the two apps. Leave unset to hide
# the link.
ASSESSMENTS_APP_URL="http://localhost:3001"
